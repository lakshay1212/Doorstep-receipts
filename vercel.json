{
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/webhooks/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/healthz",
      "destination": "/api/index.ts"
    },
    {
      "source": "/r/(.*)",
      "destination": "/api/index.ts"
    }
  ]
}
