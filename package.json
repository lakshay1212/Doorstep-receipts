  "private": true,
  "type": "module",
  "description": "Proof of arrival for home-service visits, built on Ring webhooks.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
