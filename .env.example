# --- Server ---
PORT=3000
# Public URL used when building share links (leave empty to derive from the request)
PUBLIC_BASE_URL=
DATA_FILE=./data/db.json

# --- Ring ---
# HMAC signing key issued with your Ring partner credentials. Required in production.
# In development it defaults to "dev-signing-key", which the built-in simulator uses.
RING_WEBHOOK_SIGNING_KEY=
# Ring account the demo visits belong to (the simulator uses the same one)
DEMO_ACCOUNT_ID=ava1.ring.account.DEMO
# Optional: OAuth bearer token to list real devices from api.amazonvision.com
RING_ACCESS_TOKEN=

# --- Amazon Bedrock (optional, powers the visit summary) ---
# Any model that supports the Converse API. If unset, a deterministic template summary is used.
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1

# --- Hardening ---
# If set, every /api request (except public receipts) must send this in the x-dashboard-key header
DASHBOARD_API_KEY=
# Defaults to true outside production. Turn off on any public deployment.
ENABLE_SIMULATOR=
